# ==========================================
# GENERAL
# ==========================================
NODE_ENV=development

# ==========================================
# API (NestJS)
# ==========================================
API_PORT=3000
API_HOST=0.0.0.0

# Database
MONGODB_URI=mongodb://mongodb:27017/gdash-weather
# or MongoDB Atlas:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/gdash-weather?retryWrites=true&w=majority

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Default Admin User
ADMIN_EMAIL=admin@gdash.com
ADMIN_PASSWORD=Admin@123456
ADMIN_NAME=Administrator

# AI Service (optional - for advanced insights)
OPENAI_API_KEY=sk-your-openai-api-key-here
# or
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# External API (optional - PokéAPI doesn't need key)
EXTERNAL_API_BASE_URL=https://pokeapi.co/api/v2

# ==========================================
# MESSAGE BROKER (RabbitMQ)
# ==========================================
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=admin123
RABBITMQ_VHOST=/
RABBITMQ_QUEUE=weather-data
RABBITMQ_EXCHANGE=weather-exchange
RABBITMQ_ROUTING_KEY=weather.collected

# Management UI
RABBITMQ_MANAGEMENT_PORT=15672

# ==========================================
# PYTHON COLLECTOR
# ==========================================
COLLECTOR_INTERVAL=3600  # seconds (1 hour)

# Weather API (Open-Meteo - no key needed)
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
WEATHER_LATITUDE=-23.5505  # São Paulo, BR (change to your location)
WEATHER_LONGITUDE=-46.6333
WEATHER_TIMEZONE=America/Sao_Paulo

# Or OpenWeather (requires API key)
# OPENWEATHER_API_KEY=your-openweather-api-key
# OPENWEATHER_API_URL=https://api.openweathermap.org/data/2.5
# OPENWEATHER_CITY=Sao Paulo,BR

# ==========================================
# GO WORKER
# ==========================================
WORKER_LOG_LEVEL=info
WORKER_RETRY_ATTEMPTS=3
WORKER_RETRY_DELAY=5  # seconds
API_BASE_URL=http://api:3000

# ==========================================
# FRONTEND (React)
# ==========================================
VITE_API_URL=http://localhost:3000/api
VITE_APP_TITLE=GDASH Weather Insights

# ==========================================
# DOCKER
# ==========================================
COMPOSE_PROJECT_NAME=gdash-weather
